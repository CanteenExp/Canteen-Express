# Copy to backend/.env for local dev, or set these same keys in Railway
# (Service -> Variables) so the deployed app behaves exactly like local.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# Database (Supabase PostgreSQL). Leave DB_HOST empty (or set USE_SQLITE=True)
# to fall back to SQLite.
DB_NAME=postgres
DB_USER=postgres.xxxxx
DB_PASSWORD=change-me
DB_HOST=
DB_PORT=6543
# Retry budget for transient DNS/network blips reaching the pooler, so a router
# hiccup does not crash the server or 500 every request. See config/db_backends/.
DB_CONNECT_ATTEMPTS=4
DB_CONNECT_BACKOFF=0.5

# EMAIL (SMTP is the only supported transport)
# Use a Gmail App Password (Google Account -> Security -> 2-Step Verification ->
# App passwords), not your account password. Set EMAIL_HOST_PASSWORD as a
# secret (sync: false) on Render.
#
# WARNING: Render's FREE plan and Railway Free/Hobby/Trial BLOCK outbound TCP on
# ports 25/465/587. On those hosts every send fails with
# "OSError: [Errno 101] Network is unreachable", so faculty OTP delivery
# (signup and password reset) WILL NOT WORK. The on-screen OTP fallback is
# DEBUG-only, so production has no way to complete signup. Delivering OTP on a
# free plan requires either a host that permits outbound SMTP or an HTTPS mail
# API transport. EMAIL_TIMEOUT keeps the failure fast instead of hanging the
# request, and a failed send clears the OTP session state so the user sees an
# honest error rather than a misleading 400.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your.app.address@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Canteen Express <your.app.address@example.com>
# Fail a blocked/unreachable send fast (seconds) instead of freezing the request
# until the platform's gunicorn timeout kills the worker.
EMAIL_TIMEOUT=10

# Optional, defaults False
ENFORCE_GEOFENCE=True
ENFORCE_OPERATING_HOURS=False

# Road-following routes for the live delivery maps. No API keys needed: both
# defaults are free, key-less public OSRM/Valhalla servers. Point these at a
# self-hosted instance if public traffic becomes an issue. If routing is off or
# every provider is unreachable, the maps fall back to a straight line, so
# tracking keeps working either way.
ROUTING_ENABLED=True
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
# Seconds to wait on a routing server before giving up (must stay well under
# the gunicorn timeout, which is 60s in the Procfile).
ROUTING_TIMEOUT=4
# How long a computed route is reused; the rider only needs a new one every
# few metres and the tracking page polls every few seconds.
ROUTING_CACHE_SECONDS=600

# Ignore GPS fixes whose accuracy radius is worse than this many metres, keeping
# the last known good rider position on the map. Raise it on very old phones.
GPS_MAX_ACCURACY_M=40