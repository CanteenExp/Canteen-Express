# Copy to backend/.env for local dev, or set these same keys in Railway
# (Service -> Variables) so the deployed app behaves exactly like local.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# Database (Supabase PostgreSQL). Leave DB_HOST empty to fall back to SQLite.
DB_NAME=postgres
DB_USER=postgres.xxxxx
DB_PASSWORD=change-me
DB_HOST=
DB_PORT=6543

# SMTP (Gmail app password). Used on local dev and on platforms that allow
# outbound SMTP. Railway Free/Hobby/Trial plans BLOCK outbound SMTP, so the
# deployed app must use SENDGRID_API_KEY below instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=canteenexpress26@gmail.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Canteen Express <canteenexpress26@gmail.com>
EMAIL_TIMEOUT=10

# HTTPS EMAIL API (required on Railway free plans; port 443 always allowed).
# When set, all OTP emails go through SendGrid instead of SMTP. Free plan is
# 100 emails/day. Steps: app.sendgrid.com -> create account -> Settings ->
# API Keys -> create key with "Mail Send" access -> verify a Single Sender
# (email link, no DNS needed) -> set these two vars:
#  SENDGRID_API_KEY=SG.xxxxxxxx
#  EMAIL_FROM=Name <verified-sender@your-inbox>  (e.g. Canteen Express <canteenexpress26@gmail.com>)
# EMAIL_TIMEOUT makes a blocked/unreachable send fail fast (seconds) instead of
# freezing the request until the platform kills the worker.

# Optional, defaults False
ENFORCE_GEOFENCE=True