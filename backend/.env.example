# Copy to backend/.env for local dev, or set these same keys in Railway
# (Service -> Variables) so the deployed app behaves exactly like local.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# Database (Supabase PostgreSQL). Leave DB_HOST empty to fall back to SQLite.
DB_NAME=postgres
DB_USER=postgres.xxxxx
DB_PASSWORD=change-me
DB_HOST=
DB_PORT=6543

# SMTP (Gmail app password). Without these the OTP email cannot be sent;
# the code then shows on-screen instead. From address follows EMAIL_HOST_USER.
# Port 587 requires STARTTLS (EMAIL_USE_TLS=True); port 465 requires
# EMAIL_USE_SSL=True. Set email vars in Railway Service -> Variables too.
# EMAIL_TIMEOUT makes a blocked/unreachable SMTP fail fast (seconds) instead of
# freezing the request until the platform kills the worker.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=canteenexpress26@gmail.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Canteen Express <canteenexpress26@gmail.com>
EMAIL_TIMEOUT=10

# Optional, defaults False
ENFORCE_GEOFENCE=True