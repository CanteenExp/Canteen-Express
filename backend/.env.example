# Copy to backend/.env for local dev, or set these same keys in Railway
# (Service -> Variables) so the deployed app behaves exactly like local.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# Database (Supabase PostgreSQL). Leave DB_HOST empty to fall back to SQLite.
DB_NAME=postgres
DB_USER=postgres.xxxxx
DB_PASSWORD=change-me
DB_HOST=
DB_PORT=6543

# SMTP (Gmail app password). Used on local dev and on platforms that allow
# outbound SMTP. Railway Free/Hobby/Trial plans BLOCK outbound SMTP, so the
# deployed app must use SENDGRID_API_KEY below instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your.app.address@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Canteen Express <your.app.address@example.com>
EMAIL_TIMEOUT=10

# HTTPS EMAIL API (required on free plans of Railway/Render, which block
# outbound SMTP; port 443 is always allowed). When set, all OTP emails go
# through the API instead of SMTP. FREE option that avoids SMTP blocks:
#   Brevo (brevo.com) - 300 emails/day free.
#   1. Sign up / verify your email.
#   2. Settings -> Senders & IPs -> Senders -> Add sender: verify
#      canteenexpress26@gmail.com via the confirmation link (no DNS needed).
#   3. Settings -> SMTP & API -> API keys -> Generate (v3) -> copy the key.
#   4. Set these two vars (also on Railway/Render Environment):
#       BREVO_API_KEY=xkeysib-xxxx
#       EMAIL_FROM=Canteen Express <canteenexpress26@gmail.com>  # must match the verified sender
#   EMAIL_TIMEOUT makes a blocked/unreachable send fail fast (seconds) instead of
#   freezing the request until the platform kills the worker.

# Optional, defaults False
ENFORCE_GEOFENCE=True

# Road-following routes for the live delivery maps. No API keys needed: both
# defaults are free, key-less public OSRM/Valhalla servers. Point these at a
# self-hosted instance if public traffic becomes an issue. If routing is off or
# every provider is unreachable, the maps fall back to a straight line, so
# tracking keeps working either way.
ROUTING_ENABLED=True
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
# Seconds to wait on a routing server before giving up (must stay well under
# the gunicorn timeout, which is 60s in the Procfile).
ROUTING_TIMEOUT=4
# How long a computed route is reused; the rider only needs a new one every
# few metres and the tracking page polls every few seconds.
ROUTING_CACHE_SECONDS=600

# Ignore GPS fixes whose accuracy radius is worse than this many metres, keeping
# the last known good rider position on the map. Raise it on very old phones.
GPS_MAX_ACCURACY_M=40